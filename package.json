{
  "name": "lol-kit-counterpicker",
  "version": "0.1.0",
  "private": true,
  "description": "Kit-based 1v1 counter picker for League of Legends top lane",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "fetch": "tsx pipeline/fetch.ts",
    "build:data": "tsx pipeline/build.ts",
    "matchup": "tsx pipeline/cli/matchup.ts",
    "counters": "tsx pipeline/cli/counters.ts",
    "duel": "tsx pipeline/cli/duel.ts",
    "golden": "tsx pipeline/cli/golden.ts",
    "web:data": "tsx pipeline/webData.ts",
    "dev": "npm run web:data && vite web",
    "build:web": "npm run web:data && vite build web",
    "preview": "vite preview web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "undici": "8.10.2",
    "vite": "7.1.12",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
