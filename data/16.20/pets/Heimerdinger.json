    "text": {
      "gold": "5",
      "exp": "0",
      "hp": "130 – 640 (based on level) (+ 5% – 45% (based on level) AP)",
      "damagemodifier": "40% increased damage from melee champion basic attacks and turrets",
      "damage": "7 / 11 / 15 / 19 / 23 (+ 35% AP)",
      "damagetype": "Magic",
