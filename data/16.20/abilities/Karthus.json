    "parts": [
      {
        "label": "Innate",
        "text": "Innate: Upon taking fatal damage, Karthus enters a zombie state for 7 seconds, during which he can cast his abilities at no cost. If Defile has been learned, it will remain toggled on for Death Defied's entire duration. Requiem becomes disabled after 4 seconds of the duration have elapsed.",
        "leveling": [],
        "mechanics": [
          {
            "type": "revive",
            "category": "defense",
            "wording": "zombie state",
            "duration": {
              "kind": "constant",
              "value": 7
            },
            "evidence": "Innate: Upon taking fatal damage, Karthus enters a zombie state for 7 seconds, during which he can cast his abilities at no cost.",
            "conditional": false
          }
        ],
        "values": []
      },
      {
        "text": "While under this state, Karthus becomes untargetable and immune to crowd control as well as prevents all incoming damage, but is also rendered unable to move, declare basic attacks, use summoner spells, and activate items.",
        "leveling": [],
        "mechanics": [
          {
            "type": "untargetable",
            "category": "defense",
            "wording": "untargetable",
            "evidence": "While under this state, Karthus becomes untargetable and immune to crowd control as well as prevents all incoming damage, but is also rendered unable to move, declare basic attacks, use summoner spells, and activate items.",
            "conditional": false
          },
          {
            "type": "cc-immune",
            "category": "defense",
            "wording": "immune to crowd control",
            "evidence": "While under this state, Karthus becomes untargetable and immune to crowd control as well as prevents all incoming damage, but is also rendered unable to move, declare basic attacks, use summoner spells, and activate items.",
            "conditional": false
          }
        ],
        "values": []
      }
    ],
    "custom": [],
    "notes": [
      "Death Defied's untargetability does not destroy in-flight projectiles.",
      "Karthus cannot be executed by the Aspect of the Dragon during Death Defied.",
      "At the start of Death Defied, Karthus is set to 1 health.\n  - Karthus can still regenerate his health over the duration, but he will always die at the end of it.",
      "After Death Defied ends, the corpse of Karthus will retain unit collision despite being dead on the ground.",
      "Karthus' mana bar drains over the duration of Death Defied as an indicator of his time remaining in this state."
    ]
  },
